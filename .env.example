# Copy this file to .env and fill in the values. Never commit .env.

# AI provider: "anthropic" or "openrouter"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5

# Meta app (App settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# Instagram access tokens, one per account (from "Generate access tokens")
IG_TOKEN_ACC1=   # founder.world1
IG_TOKEN_ACC2=   # founder.space1
IG_TOKEN_ACC3=   # founderspace1
IG_TOKEN_ACC4=   # foundr.world
IG_TOKEN_ACC5=   # foundr_world

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Added later (before first post)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
PIXABAY_API_KEY=
